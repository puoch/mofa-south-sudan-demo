{% extends 'staff/base.html.twig' %}

{% block title %}{{ error ? 'Error: ' }}Staff sign in{% endblock %}

{% block body %}
  <h1>Staff sign in</h1>
  {% if error %}
    <div class="panel panel--warning" role="alert"><p>{{ error.messageKey|trans(error.messageData, 'security') }}</p></div>
  {% endif %}
  <form method="post" action="{{ path('staff_login') }}" novalidate>
    <div class="form-item">
      <label for="email" class="form-required">Email address</label>
      <input type="email" id="email" name="email" value="{{ last_email }}" autocomplete="username" required>
    </div>
    <div class="form-item">
      <label for="password" class="form-required">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
    </div>
    <div class="form-item">
      <label for="code" class="form-required">Authenticator code</label>
      <div id="code_help" class="form-item__description">The 6-digit code from your authenticator app. Text-message codes are not used.</div>
      <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" aria-describedby="code_help" required>
    </div>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('staff_login') }}">
    <div class="form-actions"><input type="submit" value="Sign in"></div>
  </form>
  <p>Sessions end after 15 minutes without activity.</p>
{% endblock %}
