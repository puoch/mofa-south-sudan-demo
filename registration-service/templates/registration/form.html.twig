{% extends 'base.html.twig' %}
{% form_theme form 'form/theme.html.twig' %}

{% block title %}{{ form.vars.submitted and not form.vars.valid ? 'Error: ' }}Register as a member of the diaspora{% endblock %}

{% block body %}
  <h1>Register as a member of the diaspora</h1>

  {% if form.vars.submitted and not form.vars.valid %}
    <div class="panel panel--warning error-summary" role="alert" aria-labelledby="error-summary-title" tabindex="-1">
      <h2 id="error-summary-title" class="h3">There is a problem</h2>
      <ul>
        {% for error in form.vars.errors %}
          <li>{{ error.message }}</li>
        {% endfor %}
        {% for child in form %}
          {% for error in child.vars.errors %}
            <li><a href="#{{ child.vars.id }}">{{ error.message }}</a></li>
          {% endfor %}
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  <div class="panel">
    <p><strong>This form is a prototype.</strong> It shows how registration could work once the Ministry approves it. Use made-up details only. Passport numbers must start with SYN and email addresses must end in example.org or a similar test domain, so real details are refused.</p>
    <p>Registering is not proof of nationality and does not verify your identity.</p>
  </div>

  {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
    <fieldset>
      <legend>About you</legend>
      {{ form_row(form.fullName) }}
      {{ form_row(form.dateOfBirth) }}
      {{ form_row(form.nationality) }}
    </fieldset>
    <fieldset>
      <legend>Contact details</legend>
      {{ form_row(form.email) }}
      {{ form_row(form.phone) }}
    </fieldset>
    <fieldset>
      <legend>Where you live</legend>
      {{ form_row(form.countryOfResidence) }}
      {{ form_row(form.cityOfResidence) }}
    </fieldset>
    <fieldset>
      <legend>Passport</legend>
      {{ form_row(form.passportNumber) }}
      {{ form_row(form.passportIssuingCountry) }}
      {{ form_row(form.passportExpiry) }}
    </fieldset>
    <fieldset>
      <legend>Confirm</legend>
      {{ form_row(form.syntheticConfirmation) }}
      {{ form_row(form.privacyAcknowledged) }}
      <p><a href="{{ path('privacy') }}">Read the draft privacy notice</a></p>
    </fieldset>
    {{ form_rest(form) }}
    <div class="form-actions">
      <input type="submit" value="Submit registration">
    </div>
  {{ form_end(form) }}
{% endblock %}
