# Copy to .env for local tooling, or set these in your environment.
# NEVER commit real values. Staging and production values belong in the
# hosting platform's secrets manager.
DB_NAME=mofa
DB_USER=mofa
DB_PASSWORD=change-me-local-only
DB_HOST=127.0.0.1
DB_PORT=5432
# Generate with: php -r 'echo bin2hex(random_bytes(32));'
DRUPAL_HASH_SALT=
# Comma-separated regular expressions, e.g. ^mofa\.ddev\.site$
DRUPAL_TRUSTED_HOSTS=
# hide | some | all | verbose
DRUPAL_ERROR_LEVEL=hide
MOFA_ENVIRONMENT=development
