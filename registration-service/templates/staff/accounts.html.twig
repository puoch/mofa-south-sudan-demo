{% extends 'staff/base.html.twig' %}

{% block title %}Staff accounts{% endblock %}

{% block body %}
  <h1>Staff accounts</h1>
  <p>Create accounts with <code>php bin/console registry:staff:create</code>, which shows the password and authenticator secret once. Account administrators cannot see registration records.</p>
  <div class="table-wrap" role="region" aria-label="Staff accounts" tabindex="0">
    <table>
      <caption class="visually-hidden">Staff accounts</caption>
      <thead><tr><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Mission</th><th scope="col">Last sign-in</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
      <tbody>
        {% for account in accounts %}
          <tr>
            <td>{{ account.email }}</td>
            <td>{{ account.roleLabel }}</td>
            <td>{{ account.mission ? account.mission.code : '' }}</td>
            <td>{{ account.lastLoginAt ? account.lastLoginAt|date('j M Y H:i') : 'Never' }}</td>
            <td>{{ account.active ? 'Active' : 'Deactivated' }}</td>
            <td>
              {% if account != app.user %}
                <form method="post" action="{{ path('staff_account_active', {id: account.id}) }}">
                  <input type="hidden" name="_token" value="{{ csrf_token('account-' ~ account.id) }}">
                  <input type="hidden" name="active" value="{{ account.active ? '0' : '1' }}">
                  <button type="submit" class="button-link">{{ account.active ? 'Deactivate' : 'Reactivate' }}<span class="visually-hidden"> {{ account.email }}</span></button>
                </form>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
