{#
/**
 * @file
 * Listing wrapper: intro text, filters, results, pager.
 */
#}
<div{{ attributes.addClass('listing', 'listing--' ~ id|clean_class) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if header %}
    <div class="listing__header">{{ header }}</div>
  {% endif %}
  {% if exposed %}
    <div class="listing__filters">{{ exposed }}</div>
  {% endif %}
  {{ attachment_before }}
  {% if rows %}
    <div class="listing__results">{{ rows }}</div>
  {% elseif empty %}
    <div class="listing__empty">{{ empty }}</div>
  {% endif %}
  {{ pager }}
  {{ attachment_after }}
  {{ more }}
  {% if footer %}
    <div class="listing__footer">{{ footer }}</div>
  {% endif %}
  {{ feed_icons }}
</div>
